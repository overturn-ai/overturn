{
  "name": "Overturn",
  "author": {
    "name": "Overturn AI",
    "email": "support@overturn.run",
    "url": "https://overturn.run"
  },
  "defaultLocale": "en",
  "private": true,
  "location": {
    "ticket_sidebar": {
      "url": "assets/iframe.html",
      "flexible": true
    }
  },
  "version": "0.1.6",
  "frameworkVersion": "2.0",
  "parameters": [
    {
      "name": "overturn_api_key",
      "type": "text",
      "required": true,
      "secure": true,
      "description": "Overturn Project API key (Settings → API keys)"
    },
    {
      "name": "overturn_base_url",
      "type": "text",
      "required": false,
      "default": "https://api.overturn.run",
      "description": "Overturn API URL when self-hosting"
    },
    {
      "name": "agent",
      "type": "text",
      "required": false,
      "default": "support-reply",
      "description": "Workflow name (one suite per workflow)"
    },
    {
      "name": "reason_pack",
      "type": "text",
      "required": false,
      "default": "support",
      "description": "Reason pack: support (default) or claims"
    },
    {
      "name": "require_reason",
      "type": "checkbox",
      "required": false,
      "default": true,
      "description": "Prompt for a reason when reply is changed"
    },
    {
      "name": "capture_internal_notes",
      "type": "checkbox",
      "required": false,
      "default": false,
      "description": "Also capture internal notes, not only public replies"
    },
    {
      "name": "decision_fields",
      "type": "text",
      "required": false,
      "default": "",
      "description": "Custom decision fields as id:label pairs"
    },
    {
      "name": "scope_tag",
      "type": "text",
      "required": false,
      "default": "",
      "description": "Optional tag to limit which tickets are watched"
    },
    {
      "name": "min_draft_chars",
      "type": "text",
      "required": false,
      "default": "80",
      "description": "Minimum draft length (characters)"
    }
  ]
}
