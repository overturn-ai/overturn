{
  "name": "@overturn/intercom-app",
  "version": "0.1.0",
  "private": true,
  "description": "Overturn capture adapter for Intercom Canvas Kit",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
