{
  "name": "@overturn-ai/intercom-app",
  "version": "0.1.6",
  "private": true,
  "description": "Overturn for Intercom: captures what the AI drafted, what the teammate sent, and why, as a replayable case",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "require": "./dist/capture.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@overturn-ai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
