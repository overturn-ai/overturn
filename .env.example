# --- API (apps/api) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/overturn
PORT=4000
# Used to sign magic-link tokens and sessions (web auth). Any long random string.
AUTH_SECRET=change-me
# Resend, for magic-link email. Leave empty to print links to the API log instead.
RESEND_API_KEY=
EMAIL_FROM=Overturn <login@example.com>
# Public URL of the web app, used in magic links
WEB_URL=http://localhost:3000

# --- Model providers (replay + judge, M4+). Use cheap models in tests. ---
OPENAI_API_KEY=
# optional OpenAI-compatible gateway for openai/ models (Helicone, LiteLLM)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Together project (proj_…): with it set, trained models get a dedicated endpoint before the gate
TOGETHER_PROJECT_ID=
# Any OpenAI-compatible server (vLLM, Ollama, TGI): replay with local/<model>. Air-gapped replay needs only this.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=

# --- SDK / CLI / example agent ---
OVERTURN_API_KEY=ov_live_...
OVERTURN_BASE_URL=http://localhost:4000

# --- Web (apps/web) ---
OVERTURN_API_URL=http://localhost:4000


# --- Agent tooling (read by .mcp.json; never commit real values) ---
CONTEXT7_API_KEY=            # context7.com — optional, raises rate limit
EXA_API_KEY=                 # exa.ai
FIRECRAWL_API_KEY=           # firecrawl.dev
APIFY_TOKEN=                 # apify.com
POSTHOG_PERSONAL_API_KEY=    # posthog.com → Settings → Personal API keys (phx_…)
NEXT_PUBLIC_POSTHOG_KEY=     # posthog project key (phc_…) for the web app
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=                  # sentry.io project DSN (also set NEXT_PUBLIC_SENTRY_DSN to the same)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # for source maps in CI
STRIPE_SECRET_KEY=           # sk_live_… / sk_test_…
AGENTMAIL_API_KEY=           # agentmail.to — inbox already created, see CLAUDE.md
AGENTPHONE_API_KEY=          # agentphone.ai
LINEAR_API_KEY=              # for the overnight loop in CI only (Claude Code uses OAuth)
# Linear, GitHub, Sentry, Vercel/Railway MCPs use OAuth: run `claude` once and approve the browser prompt.
