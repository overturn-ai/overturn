{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}"
      }
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "GH=$(command -v gh 2>/dev/null); [ -n \"$GH\" ] || for p in /opt/homebrew/bin/gh /usr/local/bin/gh \"$HOME/.local/bin/gh\"; do [ -x \"$p\" ] && GH=$p && break; done; T=$(\"$GH\" auth token 2>/dev/null); printf '{\"Authorization\":\"Bearer %s\"}' \"$T\""
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--dsn",
        "${DATABASE_URL:-postgres://postgres:postgres@localhost:5432/overturn}"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "lightpanda": {
      "command": "${HOME}/.local/bin/lightpanda",
      "args": [
        "mcp"
      ]
    },
    "paper": {
      "type": "http",
      "url": "http://127.0.0.1:29979/mcp"
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp"
      ]
    },
    "agentmail": {
      "type": "http",
      "url": "https://mcp.agentmail.to/mcp"
    },
    "agentphone": {
      "command": "npx",
      "args": [
        "-y",
        "agentphone-mcp"
      ],
      "env": {
        "AGENTPHONE_API_KEY": "${AGENTPHONE_API_KEY:-}"
      }
    },
    "orgo": {
      "command": "npx",
      "args": [
        "-y",
        "github:nickvasilescu/orgo-mcp"
      ],
      "env": {
        "ORGO_API_KEY": "${ORGO_API_KEY:-}",
        "ORGO_TOOLSETS": "core,screen,files,shell"
      }
    },
    "railway": {
      "command": "npx",
      "args": [
        "-y",
        "@railway/mcp-server"
      ]
    }
  }
}
